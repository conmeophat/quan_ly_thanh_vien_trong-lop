# Copy this file to .env and replace the storage secret with a random value.
# Generate it in PowerShell with: py -c "import secrets; print(secrets.token_urlsafe(48))"
NICEGUI_STORAGE_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Local computer: false. Public HTTPS deployment behind TLS: true.
COOKIE_SECURE=false
HOST=127.0.0.1
PORT=8080

# SQLite data file; the data/ directory is excluded from Git.
DATABASE_PATH=data/class_tracker.sqlite3
