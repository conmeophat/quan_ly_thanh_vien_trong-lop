# Copy this file to .env and replace BOTH secret values with independent random values.
# Generate a secret in PowerShell with: py -c "import secrets; print(secrets.token_urlsafe(48))"
NICEGUI_STORAGE_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
BOOTSTRAP_TOKEN=REPLACE_WITH_A_DIFFERENT_RANDOM_ONE_TIME_TOKEN_AT_LEAST_32_CHARACTERS

# Local computer: false. Public HTTPS deployment behind TLS: true.
COOKIE_SECURE=false
HOST=127.0.0.1
PORT=8080

# SQLite data file; the data/ directory is excluded from Git.
DATABASE_PATH=data/class_tracker.sqlite3
